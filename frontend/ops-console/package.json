{
  "name": "caseward-ops-console",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "gen:api": "openapi-typescript ../../docs/api/operations.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:api": "openapi-typescript ../../docs/api/operations.yaml -o src/api/schema.d.ts && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
